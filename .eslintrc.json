{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [
    "react-hooks"
  ],
  "rules": {
    "react-hooks/rules-of-hooks": "error"
  },
  "ignorePatterns": [
    "node_modules",
    "android",
    "ios",
    ".expo",
    "dist",
    "build"
  ],
  "overrides": [
    {
      "files": [
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx"
      ],
      "rules": {
        "react-hooks/rules-of-hooks": "off"
      }
    }
  ]
}
