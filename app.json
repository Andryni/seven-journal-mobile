{
  "expo": {
    "name": "Seven Journal",
    "slug": "seven-journal-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "seventracking",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Autoriser Seven Journal à utiliser Face ID pour déverrouiller vos données de trading."
      }
    },
    "android": {
      "package": "com.seventracking.terminal",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0B",
          "ios": {
            "backgroundColor": "#0A0A0B"
          },
          "android": {
            "backgroundColor": "#0A0A0B"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF9F1C"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser Seven Journal à utiliser Face ID pour déverrouiller vos données de trading."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Autoriser Seven Journal à enregistrer vos cartes de performance dans vos photos.",
          "savePhotosPermission": "Autoriser Seven Journal à enregistrer vos cartes de performance dans vos photos.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7bd31e7c-f825-4946-aa5f-cb5b261b8cce"
      }
    },
    "owner": "andrikely",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7bd31e7c-f825-4946-aa5f-cb5b261b8cce"
    }
  }
}
