# Supabase CLI local state, none of which belongs in the repo:
#   .supabase/        link state and access token
#   supabase/.temp/   CLI scratch files, rewritten on most commands
.supabase/
supabase/.temp/
adb_dumps/
*.ex5

# Build artefacts and local logs — never repo content, never EAS archive
# content (the 199 MB upload warning came from the previous APK riding
# along).
*.apk
# Backup archives (may contain the keystore — never repo content)
*.7z
*keystore-backup*
build-apk.log
build-local.log
eas-build.log
jdk-download.log
easlist.tmp.json
easview.tmp.json
device-log.txt
demo-missing-data.html

# Local build toolchain (JDK portable, CMake repair) — machine-only
/tools/
